{
  "lastChangelogVersion": "1.5.0",
  "defaultProvider": "ollama-cloud",
  "defaultModel": "deepseek-v4.1-flash",
  "theme": "catppuccin-mocha",
  "npmCommand": [
    "pnpm"
  ],
  "enableInstallTelemetry": false,
  "quietStartup": true,
  "tuiMode": "fullscreen",
  "hideThinkingBlock": true,
  "defaultThinkingLevel": "medium",
  "terminal": {
    "showTerminalProgress": true
  },
  "packages": [
    "npm:@pi-archimedes/sudo",
    "npm:pi-lean-ctx",
    "npm:pi-ollama-cloud"
  ],
  "extensionSettings": {
    "notifications": true,
    "pierre-diffs": {
      "enabled": true,
      "diffStyle": "auto",
      "diffIndicators": "bars",
      "lineDiffType": "word-alt",
      "overflow": "wrap",
      "hunkSeparators": "line-info",
      "lineNumbers": true,
      "backgrounds": true,
      "syntaxHighlight": true
    }
  },
  "enabledModels": [
    "ollama-cloud/*",
    "minimax/*",
    "opencode-go/*"
  ],
  "extensionChangelogVersions": {
    "{\"source\":\"npm:pi-ollama-cloud\",\"scope\":\"user\"}": "0.13.1"
  }
}
